# Copy this file to `.env` (git-ignored) for local development, and set the same
# values in Vercel → Project → Settings → Environment Variables for production.

# ─── Frontend (PUBLIC) ───────────────────────────────────────────────────────
# Anything prefixed REACT_APP_ is compiled into the browser bundle. Never put a
# secret here. Optional: where the form POSTs. Leave blank to use /api/lead.
REACT_APP_LEAD_ENDPOINT=

# Supabase client (anon key is public-safe)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Admin portal credentials (PUBLIC - compiled into browser)
# In production, override these in Vercel env vars
REACT_APP_ADMIN_USERNAME=admin
REACT_APP_ADMIN_PASSWORD=admin123

# ─── Server only (SECRET) ────────────────────────────────────────────────────
# Used exclusively by api/lead.js on Vercel's servers. NOT exposed to the browser.
# Do NOT prefix these with REACT_APP_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TRUSTEDFORM_API_KEY=your-trustedform-api-key
TRUSTEDFORM_VENDOR=Accident Case Win
