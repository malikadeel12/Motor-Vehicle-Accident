# Copy this file to `.env` (git-ignored) for local development, and set the same
# values in Vercel → Project → Settings → Environment Variables for production.

# ─── Frontend (PUBLIC) ───────────────────────────────────────────────────────
# Anything prefixed REACT_APP_ is compiled into the browser bundle. Never put a
# secret here. Optional: where the form POSTs. Leave blank to use /api/lead.
REACT_APP_LEAD_ENDPOINT=

# ─── Server only (SECRET) ────────────────────────────────────────────────────
# Used exclusively by api/lead.js on Vercel's servers. NOT exposed to the browser.
# Do NOT prefix these with REACT_APP_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TRUSTEDFORM_API_KEY=
TRUSTEDFORM_VENDOR=Accident Case Win
